generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expense {
  id          Int      @id @default(autoincrement())
  telegramId  String
  amount      Int
  category    String
  description String
  date        String
  createdAt   DateTime @default(now())
}
